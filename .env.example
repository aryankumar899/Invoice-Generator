# ─────────────────────────────────────────────
#  Invoice AI — Backend Environment Variables
#  Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# App
NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT — use a long random string (min 32 chars)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret_key
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Frontend URL (used for password-reset links)
FRONTEND_URL=http://localhost:5173

# EmailJS — Account → API keys + Email Services + Email Templates
# Enable Account → Security → Allow EmailJS API for non-browser applications
# Template To Email must be {{to_email}}
EMAILJS_SERVICE_ID=service_by7rc99
EMAILJS_TEMPLATE_ID=template_qgk2bcn
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key
EMAILJS_TEMPLATE_CREDENTIALS=template_qgk2bcn
EMAILJS_TEMPLATE_RESET=template_enrb6um

# Gemini (invoice scan / extract) — keep this on the server only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
